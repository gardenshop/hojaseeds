{
  "schema_version": 5,
  "spreadsheet_title": "Hoja Seeds",
  "sheets": {
    "Products": [
      "id", "name", "cat", "unit", "icon", "price", "type",
      "description", "pack_size", "seed_count", "weight", "sale_price",
      "stock_status", "active", "featured", "image_url", "image_alt",
      "season", "sowing_months", "sort_order", "updated_at"
    ],
    "Inventory": ["product_id", "available_quantity", "reserved_quantity", "updated_at"],
    "Orders": [
      "timestamp", "orderId", "name", "phone", "address", "city", "postal", "notes",
      "paymentMethod", "advanceMethod", "transactionRef", "items", "subtotal",
      "deliveryFee", "total", "payNow", "codDue"
    ],
    "OrderItems": [
      "orderId", "productId", "productNameSnapshot", "packSizeSnapshot",
      "quantity", "unitPrice", "lineTotal"
    ],
    "Contact": ["timestamp", "name", "phone", "message"],
    "AuditLog": ["timestamp", "admin_email", "action", "entity_type", "entity_id", "before", "after", "result"],
    "Settings": ["key", "value"],
    "Leads": [
      "leadId", "createdAt", "updatedAt", "status", "fullName", "phone", "address",
      "city", "postalCode", "notes", "cartJson", "itemsSubtotal", "estimatedOrderTotal",
      "eligiblePaymentModes", "utmSource", "fbp", "fbc", "lastStep", "abandonReason", "convertedOrderId"
    ],
    "LoadTestOrders": [
      "timestamp", "testRunId", "sequence", "orderId", "idempotencyKey",
      "paymentMode", "paymentChannel", "items", "itemsSubtotal", "deliveryFee",
      "orderTotal", "payNow", "codDue", "status", "requestFingerprint", "processingMs", "errorCode"
    ]
  }
}
